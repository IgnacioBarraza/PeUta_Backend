// See the diagram in https://dbdiagram.io/d

Project ProyectoEvaluacionFeria {
  database_type: "PostgreSQL"
}

/* CLIENTES */
Table Client {
  id uuid [pk]
  name varchar
  api_key varchar
  created_at timestamp
  updated_at timestamp
}

/* USUARIOS */
Table User {
  id uuid [pk]
  rut varchar
  name varchar
  password varchar
  role varchar
  client_id uuid [ref: > Client.id]
  created_at timestamp
  updated_at timestamp
}

/* FERIAS */
Table Event {
  id uuid [pk]
  name varchar
  date date
  location varchar
  client_id uuid [ref: > Client.id]
  created_at timestamp
  updated_at timestamp
}

/* CATEGORÍAS */
Table Category {
  id uuid [pk]
  name varchar
  event_id uuid [ref: > Event.id]
}

/* PROYECTOS */
Table Project {
  id uuid [pk]
  name varchar
  description text
  category_id uuid [ref: > Category.id]
  event_id uuid [ref: > Event.id]
  client_id uuid [ref: > Client.id]
}

/* ESTUDIANTES */
Table Student {
  id uuid [pk]
  name varchar
  rut varchar
  project_id uuid [ref: > Project.id]
}

/* CRITERIOS DE EVALUACIÓN */
Table EvaluationCriterion {
  id uuid [pk]
  question text
  max_score int
  event_id uuid [ref: > Event.id]
}

/* EVALUACIONES */
Table Evaluation {
  id uuid [pk]
  evaluator_id uuid [ref: > User.id]
  project_id uuid [ref: > Project.id]
  event_id uuid [ref: > Event.id]
  created_at timestamp
}

/* RESPUESTAS POR CRITERIO */
Table EvaluationResponse {
  id uuid [pk]
  evaluation_id uuid [ref: > Evaluation.id]
  criterion_id uuid [ref: > EvaluationCriterion.id]
  score int
}

/* REGISTRO DE ASISTENCIA */
Table AttendanceRecord {
  id uuid [pk]
  name varchar
  student_id uuid [ref: > Student.id]
  project_id uuid [ref: > Project.id]
  event_id uuid [ref: > Event.id]
  created_at timestamp
}
