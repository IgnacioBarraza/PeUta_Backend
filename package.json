{
  "name": "hyosei_backend",
  "version": "2.1.2",
  "description": "Backend for Hyosei",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "ts-node-dev src/infrastructure/server/server.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/orm/data-source.ts src/infrastructure/orm/migrations/",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/orm/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/orm/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/infrastructure/orm/data-source.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/IgnacioBarraza/Hyosei_Backend.git"
  },
  "author": "IgnacioBarraza",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IgnacioBarraza/Hyosei_Backend/issues"
  },
  "homepage": "https://github.com/IgnacioBarraza/Hyosei_Backend#readme",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.27.0",
    "express-rate-limit": "^7.5.0",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.2",
    "lint-staged": "^16.0.0",
    "pg": "^8.14.0",
    "prettier": "^3.5.3",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.21",
    "typescript-eslint": "^8.32.1",
    "validator": "^13.12.0",
    "zod": "^3.24.2"
  }
}